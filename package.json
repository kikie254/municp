{
  "name": "iten-tambach-municipality",
  "version": "2.0.0",
  "private": true,
  "description": "Demonstration website prepared for institutional review; not an approved official municipal publication.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:source": "node scripts/check-source.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "npx firebase-tools emulators:exec --only firestore,storage --project demo-itm \"vitest run --config vitest.rules.config.ts\"",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:api": "node scripts/verify-api.mjs",
    "admin:provision": "tsx scripts/provision-admin.ts",
    "migrate:to-firestore": "tsx scripts/migrate-to-firestore.ts",
    "env:check": "tsx scripts/check-env.ts",
    "env:check:strict": "tsx scripts/check-env.ts --strict",
    "backup:firestore": "node scripts/backup-firestore.mjs",
    "restore:firestore": "node scripts/restore-firestore.mjs",
    "verify:all": "npm run typecheck && npm run lint && npm run test && npm run test:rules && npm run check:source",
    "setup:vercel": "node scripts/setup-vercel.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^12.7.0",
    "lucide-react": "0.474.0",
    "next": "15.5.29",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4.17",
    "dotenv": "^16.4.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
